# Copy to .env and fill in. Never commit .env.
# mock = offline deterministic simulator (no key needed)
LLM_PROVIDER=mock

# Required only when a provider below is used
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENROUTER_API_KEY=
# Empty = OpenRouter Auto Router (openrouter/auto)
OPENROUTER_MODEL=

# Judge model (a different, stronger model than the triage model)
# JUDGE_PROVIDER: mock | anthropic | openrouter (empty = same as LLM_PROVIDER)
# JUDGE_MODEL: model id for that provider (empty = the provider's normal model)
JUDGE_PROVIDER=
JUDGE_MODEL=

# Jira Cloud integration (python -m src.triage --source jira --ids KEY-123)
# JIRA_EMAIL + JIRA_API_TOKEN -> Basic auth (Jira Cloud).
# JIRA_EMAIL empty -> the token is sent as a Bearer token (Jira Data Center PAT; untested).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Opt out of DeepEval telemetry
DEEPEVAL_TELEMETRY_OPT_OUT=YES
